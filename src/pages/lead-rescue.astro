---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import TerminalWindow from '@/components/TerminalWindow.astro';
import { site, links } from '@/config/site';
import { leadRescue } from '@/config/lead-rescue';

// Inline link inside body copy, matching the underline style of .prose-dark a.
const proseLink =
  'text-accent underline decoration-accent/40 underline-offset-[3px] transition-colors hover:text-accent-bright';

const title = 'Lead Rescue · enquiry routing for UK law firms';
const description =
  'I build systems that capture new business enquiries from your website and route them to the right solicitor, automatically. Set up in five working days.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Lead Rescue',
  description,
  serviceType: 'Enquiry capture and routing for law firms',
  areaServed: { '@type': 'Country', name: 'United Kingdom' },
  provider: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
    email: `mailto:${site.email}`,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  ogImage="/og-lead-rescue.png"
  ogImageAlt="Lead Rescue: every enquiry, in front of the right person. Enquiry routing for UK law firms."
  navCtaLabel="Get in touch"
  navCtaHref={links.leadRescue}
>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-5 pt-20 pb-16 sm:px-8 sm:pt-28 sm:pb-24">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <div class="flex flex-col gap-7">
        <SectionLabel>lead-rescue</SectionLabel>
        <h1 class="text-hero font-bold text-fg">
          {leadRescue.hero.headline}<span class="cursor-blink" aria-hidden="true"></span>
        </h1>
        <p class="max-w-xl text-lg leading-relaxed text-fg-secondary">
          {leadRescue.hero.subline}
        </p>
        <div class="flex flex-wrap gap-3">
          <Button href={links.leadRescue}>{leadRescue.hero.primaryCta}</Button>
          <Button href="#how-it-works" variant="ghost">{leadRescue.hero.secondaryCta}</Button>
        </div>
      </div>

      <TerminalWindow title="tail · enquiries" class="fade-up">
        <pre
          class="whitespace-pre text-fg-secondary"><span class="text-accent">$</span> tail -f enquiries.log

<span class="text-fg-muted">14:01:31</span>  capture   website form · conveyancing
<span class="text-fg-muted">14:01:33</span>  clean     duplicate check passed
<span class="text-fg-muted">14:01:34</span>  route     <span class="text-accent">→</span> J. Whitfield, property
<span class="text-fg-muted">14:01:35</span>  reply     acknowledgement sent
<span class="text-fg-muted">14:01:36</span>  logged    <span class="text-accent">5s</span> from submission to inbox</pre>
      </TerminalWindow>
    </div>
  </section>

  <!-- The problem -->
  <section class="border-y border-border bg-surface/40" aria-labelledby="problem-heading">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <div class="flex flex-col gap-3">
        <SectionLabel>the-problem</SectionLabel>
        <h2 id="problem-heading" class="text-display font-bold text-fg">
          How enquiries go missing:
        </h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          leadRescue.problems.map((problem) => (
            <article class="card-interactive fade-up flex flex-col gap-4 rounded-xl p-6 sm:p-8">
              <h3 class="text-lg font-bold tracking-tight text-fg">{problem.title}</h3>
              <p class="text-sm leading-relaxed text-fg-secondary">{problem.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What it does -->
  <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28" aria-labelledby="what-heading">
    <div class="flex flex-col gap-3">
      <SectionLabel>what-it-does</SectionLabel>
      <h2 id="what-heading" class="text-display font-bold text-fg">What the system does:</h2>
    </div>
    <ul class="mt-8 flex max-w-3xl flex-col">
      {
        leadRescue.capabilities.map((capability) => (
          <li class="flex flex-col gap-1 border-b border-border py-5 last:border-b-0 sm:flex-row sm:gap-6">
            <h3 class="font-mono text-sm font-semibold text-accent sm:w-40 sm:shrink-0">
              {capability.title}
            </h3>
            <p class="text-sm leading-relaxed text-fg-secondary">{capability.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Why me -->
  <section class="border-y border-border bg-surface/40" aria-labelledby="why-heading">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <div class="flex flex-col gap-3">
        <SectionLabel>why-me</SectionLabel>
        <h2 id="why-heading" class="text-display font-bold text-fg">Why me:</h2>
      </div>
      <div class="mt-8 flex max-w-xl flex-col gap-5 text-base leading-relaxed text-fg-secondary">
        {
          leadRescue.whyMe.map((paragraph) => {
            const parts = paragraph.link ? paragraph.text.split(paragraph.link.phrase) : [];
            // Fall back to plain text if the phrase no longer matches the copy.
            if (!paragraph.link || parts.length !== 2) return <p>{paragraph.text}</p>;
            // Kept on one line: Astro turns line breaks between these into spaces.
            return (
              <p>{parts[0]}<a href={paragraph.link.href} class={proseLink}>{paragraph.link.phrase}</a>{parts[1]}</p>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section
    id="how-it-works"
    class="mx-auto max-w-6xl scroll-mt-20 px-5 py-20 sm:px-8 sm:py-28"
    aria-labelledby="how-heading"
  >
    <div class="flex flex-col gap-3">
      <SectionLabel>how-it-works</SectionLabel>
      <h2 id="how-heading" class="text-display font-bold text-fg">How it works:</h2>
    </div>
    <ol class="mt-8 flex max-w-3xl flex-col">
      {
        leadRescue.steps.map((step, index) => (
          <li class="flex gap-4 border-b border-border py-5 last:border-b-0 sm:gap-6">
            <span class="font-mono text-sm font-semibold text-accent" aria-hidden="true">
              0{index + 1}
            </span>
            <div class="flex flex-col gap-1">
              <h3 class="text-lg font-bold tracking-tight text-fg">{step.title}</h3>
              <p class="text-sm leading-relaxed text-fg-secondary">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Questions -->
  <section class="border-y border-border bg-surface/40" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <div class="flex flex-col gap-3">
        <SectionLabel>questions</SectionLabel>
        <h2 id="faq-heading" class="text-display font-bold text-fg">Questions:</h2>
      </div>
      <div class="mt-8 flex max-w-3xl flex-col">
        {
          leadRescue.faqs.map((faq) => (
            <details class="faq-item">
              <summary>
                <h3 class="text-lg font-bold tracking-tight text-fg">{faq.question}</h3>
              </summary>
              <p class="pb-5 text-sm leading-relaxed text-fg-secondary">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Final call to action -->
  <section aria-labelledby="cta-heading">
    <div class="mx-auto max-w-6xl px-5 py-20 text-center sm:px-8 sm:py-28">
      <h2 id="cta-heading" class="text-display font-bold text-fg">
        {leadRescue.finalCta.heading}
      </h2>
      <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-fg-secondary">
        {leadRescue.finalCta.body}
      </p>
      <div class="mt-8 flex justify-center">
        <Button href={links.leadRescue}>{leadRescue.finalCta.cta}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
