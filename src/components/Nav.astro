---
import { links } from '@/config/site';

/**
 * ctaLabel/ctaHref let a page override the header action. Landing pages that
 * offer a single contact route should not also show "Book a call".
 */
interface Props {
  ctaLabel?: string;
  ctaHref?: string;
}

const { ctaLabel = 'Book a call', ctaHref = links.bookCall } = Astro.props;

// Only off-site destinations open in a new tab. A mailto must not.
const ctaExternal = ctaHref.startsWith('http');

const navLinks = [
  { label: 'Work', href: '/#work' },
  { label: 'Services', href: '/#services' },
  { label: 'Writing', href: '/writing' },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/80 backdrop-blur-md">
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8"
    aria-label="Main"
  >
    <a href="/" class="font-mono text-sm font-medium text-fg" aria-label="CapEO Labs home">
      <span class="text-fg-muted">~/</span>cap-eo
    </a>

    <div class="flex items-center gap-2 sm:gap-6">
      <ul class="hidden items-center gap-6 sm:flex">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-mono text-[13px] text-fg-secondary transition-colors hover:text-fg"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={ctaHref}
        class="rounded-md bg-accent px-4 py-2 font-mono text-[13px] font-semibold text-black transition-colors hover:bg-accent-bright"
        {...ctaExternal ? { target: '_blank', rel: 'noopener' } : {}}
      >
        {ctaLabel}
      </a>
    </div>
  </nav>
</header>
