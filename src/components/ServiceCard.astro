---
interface Props {
  title: string;
  body: string;
  engagement: string;
}

const { title, body, engagement } = Astro.props;
---

<article class="card-interactive fade-up flex flex-col gap-4 rounded-xl p-6 sm:p-8">
  <h3 class="text-lg font-bold tracking-tight text-fg">{title}</h3>
  <p class="text-sm leading-relaxed text-fg-secondary">{body}</p>
  <p class="mt-auto border-t border-border pt-4 font-mono text-[12px] text-fg-muted">
    Typical engagement: <span class="text-fg-secondary">{engagement}</span>
  </p>
</article>
