---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="rounded-lg border border-border bg-surface p-5 sm:p-6">
  <p class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">{value}</p>
  <p class="mt-2 font-mono text-[12px] leading-relaxed text-fg-muted">{label}</p>
</div>
