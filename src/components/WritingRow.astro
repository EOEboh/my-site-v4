---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const { title, date, topic, externalUrl } = entry.data;
const isExternal = Boolean(externalUrl);
const href = externalUrl ?? `/writing/`;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a
  href={href}
  {...isExternal ? { target: '_blank', rel: 'noopener' } : {}}
  class="group flex flex-col gap-1 border-b border-border py-5 transition-colors last:border-b-0 hover:bg-surface sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 sm:px-3"
>
  <span class="text-base font-medium text-fg transition-colors group-hover:text-accent">
    {title}
    {isExternal && <span class="font-mono text-fg-muted" aria-hidden="true">&nbsp;↗</span>}
    {isExternal && <span class="sr-only">(external link)</span>}
  </span>
  <span class="flex shrink-0 gap-4 font-mono text-[12px] text-fg-muted">
    <span>{topic}</span>
    <time datetime={date.toISOString().slice(0, 10)}>{formattedDate}</time>
  </span>
</a>
